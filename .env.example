# 复制为 .env 并填入真实值。.env 已在 .gitignore 中，勿提交。

# 七牛访问密钥（控制台 - 密钥管理）
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=

# 存储空间名称（与控制台「空间」名称一致）
QINIU_BUCKET=

# 列举对象使用的 key 前缀（与空间内路径一致，例如 ai-images/）
QINIU_PREFIX=ai-images/

# 对外访问域名（自定义 CDN / 默认域名，不含具体文件路径，无末尾斜杠）
QINIU_PUBLIC_BASE_URL=https://cdn.example.com

# 可选：manifest 输出路径（相对仓库根目录）
# QINIU_MANIFEST_OUT=docs/public/json/ai-gallery-manifest.json

# 可选：仅包含这些扩展名，逗号分隔；留空则使用内置常见图片后缀
# QINIU_MANIFEST_EXT=png,jpg,jpeg,webp
