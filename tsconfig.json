{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "node",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM"],
    "types": ["node"],
    "baseUrl": "./",
    "paths": {
      "@docs/*": ["docs/*"],
      "@theme/*": ["docs/.vitepress/theme/*"],
      "@/*": ["./*"]
    }
  },
  "include": [
    "docs/.vitepress/**/*.ts",
    "docs/.vitepress/**/*.d.ts",
    "docs/.vitepress/**/*.vue",
    "docs/.vitepress/**/*.js",
    "types/**/*.d.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
